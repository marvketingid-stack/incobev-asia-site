{
  "name": "incobev-asia-site",
  "version": "1.0.0",
  "description": "IncoBev Asia — Phase 1 static reference build (compiled Tailwind, shared partials).",
  "private": true,
  "scripts": {
    "assemble": "node build.js",
    "css": "tailwindcss -i ./src/css/input.css -o ./dist/assets/style.css --minify",
    "css:watch": "tailwindcss -i ./src/css/input.css -o ./dist/assets/style.css --watch",
    "build": "node build.js && npm run css",
    "build:cms": "tinacms build && node build.js && npm run css",
    "tina:dev": "tinacms dev -c \"node build.js && npm run css && node serve.js\"",
    "dev": "node build.js && tailwindcss -i ./src/css/input.css -o ./dist/assets/style.css --watch",
    "serve": "node serve.js"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tinacms/cli": "^1.9.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^4.3.0",
    "tinacms": "^2.7.0",
    "worker-mailer": "^1.2.1"
  }
}
